Private Sub Worksheet_Change(ByVal Target As Range)
    Dim r As Long
    Dim valE As Variant, valH As Variant
    Dim i As Long

    ' E列以外は無視
    If Intersect(Target, Me.Range("E2:E1000")) Is Nothing Then Exit Sub

    Application.EnableEvents = False ' 防止ループ
    For Each cell In Intersect(Target, Me.Range("E2:E1000"))
        r = cell.Row
        valE = Me.Cells(r, "E").Value
        valH = Me.Cells(r, "H").Value

        For i = 4 To 7 ' D～G列
            With Me.Cells(r, i).Interior
                If (r >= 10 And r <= 15) Or (r >= 30 And r <= 46) Or (r >= 55 And r <= 57) Then
                    ' 感覚判断行
                    If valE = 0 Then
                        .Color = RGB(255, 255, 0) ' 黄色
                    ElseIf valE = 1 Then
                        .ColorIndex = xlNone ' 白
                    Else
                        .ColorIndex = xlNone ' 白
                    End If
                Else
                    ' 通常判断行
                    If IsNumeric(valE) And IsNumeric(valH) Then
                        If valE < valH Then
                            .Color = RGB(255, 255, 0) ' 黄色
                        ElseIf valE = valH Then
                            .Color = RGB(144, 238, 144) ' 緑
                        Else
                            .ColorIndex = xlNone ' 白
                        End If
                    Else
                        .ColorIndex = xlNone ' 白
                    End If
                End If
            End With
        Next i
    Next cell
    Application.EnableEvents = True
End Sub