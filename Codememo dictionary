Option Explicit

' ====== 設定 ======
Private Const WATCH_RANGE As String = "E4:E1000"   ' 監視対象範囲（E列のみ）
Private Const COL_H As Long = 8                    ' H列

' 色設定（仕様固定）
Private Const CLR_INFO_R As Long = 221, CLR_INFO_G As Long = 235, CLR_INFO_B As Long = 247   ' 空白：薄青（入力未完了の注意）
Private Const CLR_WARN_R As Long = 255, CLR_WARN_G As Long = 255, CLR_WARN_B As Long = 0     ' 警告/不足：黄色（E<H または 特殊行でE=0）
Private Const CLR_EQUAL_R As Long = 146, CLR_EQUAL_G As Long = 208, CLR_EQUAL_B As Long = 80 ' 一致：緑（E=H）

' ===========================================================================================
' E列の入力に応じて D～G を着色する。
' ・特殊行（SpecialRows）：0→黄色、1→無色、その他→Eに「入力エラー」
' ・通常行：E<H 黄色、E=H 緑、E>H 無色（Hは結合セル/文字列から数値抽出に対応）
' ・Eを空欄（削除/クリア）にした場合：E=薄青、D/F/G=無色（直ちに処理終了）
' ===========================================================================================
Private Sub Worksheet_Change(ByVal Target As Range)
    Dim rng As Range, c As Range
    Dim r As Long, i As Long
    Dim valE As Double, valH As Double
    Dim s As String
    
    On Error GoTo exit_handler
    Set rng = Intersect(Target, Me.Range(WATCH_RANGE))
    If rng Is Nothing Then Exit Sub
    
    Application.EnableEvents = False
    
    For Each c In rng.Cells
        r = c.Row
        
        ' === 空白処理：E削除/クリア → E=薄青、D・F・G=無色（Eは触らない） ===
        If LenB(Trim$(CStr(c.Value))) = 0 Then
            ' D・F・G を無色に（E=5 はスキップ）
            Me.Cells(r, 4).Interior.ColorIndex = xlNone ' D
            Me.Cells(r, 6).Interior.ColorIndex = xlNone ' F
            Me.Cells(r, 7).Interior.ColorIndex = xlNone ' G
            ' E を薄青で明示
            With c.Interior
                .Pattern = xlSolid
                .PatternColorIndex = xlAutomatic
                .Color = RGB(CLR_INFO_R, CLR_INFO_G, CLR_INFO_B) ' 221,235,247
                .TintAndShade = 0
                .PatternTintAndShade = 0
            End With
            GoTo next_cell ' 空白はここで完了（後続ロジックを回避）
        End If
        
        ' ここからは E に値が入っている：一旦無色に初期化
        c.Interior.ColorIndex = xlNone
        For i = 4 To 7
            Me.Cells(r, i).Interior.ColorIndex = xlNone
        Next
        
        ' === 特殊行（SpecialRows）判定：0/1 のみ有効 ===
        If IsSpecialRow(r) Then
            ' 入力値を正規化（全角→半角、記号/空白の整理）して 0/1 を厳密判定
            s = NormalizeDigits(CStr(c.Value))
            If s = "0" Then
                For i = 4 To 7
                    Me.Cells(r, i).Interior.Color = RGB(CLR_WARN_R, CLR_WARN_G, CLR_WARN_B) ' 255,255,0
                Next
                GoTo next_cell
            ElseIf s = "1" Then
                ' 在庫あり → 無色（初期化済み）
                GoTo next_cell
            Else
                ' 0/1 以外 → E に「入力エラー」を明示（表示崩れ回避のため一時的に文字列書式）
                Dim prevFmt As String
                prevFmt = c.NumberFormatLocal
                c.NumberFormatLocal = "@"
                c.Value = "入力エラー"
                c.NumberFormatLocal = prevFmt
                GoTo next_cell
            End If
        End If
        
        ' === 通常行：E と H の比較（Hは結合セル/文字列→数値抽出に対応） ===
        If IsNumeric(c.Value) Then valE = CDbl(c.Value) Else valE = 0
        valH = GetHNumericValue(r)
        
        For i = 4 To 7
            With Me.Cells(r, i).Interior
                If valE < valH Then
                    .Color = RGB(CLR_WARN_R, CLR_WARN_G, CLR_WARN_B)      ' 不足：黄色
                ElseIf valE = valH Then
                    .Color = RGB(CLR_EQUAL_R, CLR_EQUAL_G, CLR_EQUAL_B)    ' 一致：緑
                Else
                    .ColorIndex = xlNone                                   ' 過剰：無色
                End If
            End With
        Next
        
next_cell:
    Next c

exit_handler:
    Application.EnableEvents = True
End Sub

' ====== ユーティリティ ======

' 特殊行判定：
' ・ブック範囲の名前「SpecialRows」を優先的に解決（シート範囲名との競合回避）
' ・セルの表示文字列（Text）を正規化して解析（Value が日付/数値化されてもOK）
' ・記法は 単一/カンマ/区間(10-15) を混在可。全角記号や各種ダッシュも正規化。
Private Function IsSpecialRow(ByVal r As Long) As Boolean
    Dim rng As Range, cell As Range
    Dim raw As String, token As Variant
    Dim a As Long, b As Long
    
    On Error Resume Next
    If Not ThisWorkbook Is Nothing Then
        If Not ThisWorkbook.Names("SpecialRows") Is Nothing Then
            Set rng = ThisWorkbook.Names("SpecialRows").RefersToRange
        End If
    End If
    On Error GoTo 0
    If rng Is Nothing Then
        On Error Resume Next
        Set rng = Range("SpecialRows")
        On Error GoTo 0
    End If
    If rng Is Nothing Then Exit Function
    
    For Each cell In rng.Cells
        raw = NormalizeDelimiters(CStr(cell.Text)) ' ★ Text を使う
        If Len(raw) > 0 Then
            For Each token In Split(raw, ",")
                token = Trim$(CStr(token))
                If Len(token) = 0 Then GoTo continue_token
                If InStr(1, token, "-", vbTextCompare) > 0 Then
                    If TryParseRange(CStr(token), a, b) Then
                        If r >= a And r <= b Then IsSpecialRow = True: Exit Function
                    End If
                ElseIf IsNumeric(token) Then
                    If CLng(token) = r Then IsSpecialRow = True: Exit Function
                End If
continue_token:
            Next token
        End If
    Next cell
End Function

' "m-n" 書式を a,b にパース（m>n の場合は入れ替え、m<=n に正規化）
Private Function TryParseRange(ByVal s As String, ByRef a As Long, ByRef b As Long) As Boolean
    Dim parts() As String
    parts = Split(Replace$(s, " ", ""), "-")
    If UBound(parts) = 1 Then
        If IsNumeric(parts(0)) And IsNumeric(parts(1)) Then
            a = CLng(parts(0)): b = CLng(parts(1))
            If a > b Then
                Dim t As Long: t = a: a = b: b = t
            End If
            TryParseRange = True
        End If
    End If
End Function

' H列の比較用数値を取得（結合セル対応・文字列から最初の数値を抽出）
Private Function GetHNumericValue(ByVal r As Long) As Double
    Dim hCell As Range, txt As String, m As Object
    Set hCell = Me.Cells(r, COL_H)
    If hCell.MergeCells Then Set hCell = hCell.MergeArea(1, 1) ' 結合セルの左上セルを参照
    
    If IsNumeric(hCell.Value) And Len(hCell.Value) > 0 Then
        GetHNumericValue = CDbl(hCell.Value)
    Else
        txt = CStr(hCell.Value)
        With CreateObject("VBScript.RegExp")
            .Pattern = "(\d+)"
            .Global = False
            .IgnoreCase = True
            If .Test(txt) Then
                Set m = .Execute(txt)
                GetHNumericValue = CDbl(m(0).Value)
            Else
                GetHNumericValue = 0
            End If
        End With
    End If
End Function

' ====== 正規化ユーティリティ ======

' 全角数字/記号→半角、カンマ/空白除去、小数点除去（0/1 判定用）
Private Function NormalizeDigits(ByVal s As String) As String
    Dim i As Long, ch As String, code As Long, out As String
    s = Trim$(s)
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        code = AscW(ch)
        Select Case code
            Case &HFF10 To &HFF19 ' 全角０〜９
                ch = ChrW(code - &HFEE0)
            Case &HFF0E, &HFF61 ' 全角/半角ピリオド
                ch = "."
            Case &HFF0C ' 全角カンマ
                ch = ","
        End Select
        out = out & ch
    Next i
    out = Replace$(out, ",", "")
    out = Replace$(out, " ", "")
    out = Replace$(out, vbTab, "")
    out = Replace$(out, ".", "")
    NormalizeDigits = out
End Function

' 区切り/ダッシュ類を正規化：中文/和文の記号も取り扱い
Private Function NormalizeDelimiters(ByVal s As String) As String
    ' カンマ類：，、 → ,
    s = Replace$(s, "，", ",")
    s = Replace$(s, "、", ",")
    ' ダッシュ類：ー － — – − → -
    s = Replace$(s, "ー", "-")
    s = Replace$(s, "－", "-")
    s = Replace$(s, "—", "-")
    s = Replace$(s, "–", "-")
    s = Replace$(s, "−", "-")
    ' 余分な空白除去（全角/半角）
    s = Trim$(s)
    s = Replace$(s, vbTab, "")
    s = Replace$(s, " ", "")
    s = Replace$(s, ChrW(&H3000), "") ' 全角スペース
    NormalizeDelimiters = s
End Function