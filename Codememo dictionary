Private Sub Worksheet_Change(ByVal Target As Range)
    Dim r As Long
    Dim valE As Double, valH As Double
    Dim i As Long
    Dim isSensoryRow As Boolean
    Dim cell As Range

    If Intersect(Target, Me.Range("E2:E1000")) Is Nothing Then Exit Sub

    Application.EnableEvents = False

    For Each cell In Intersect(Target, Me.Range("E2:E1000"))
        r = cell.Row
        isSensoryRow = (r >= 10 And r <= 15) Or (r >= 30 And r <= 46) Or (r >= 55 And r <= 57)

        ' ✅ E列が空欄になったら → E列を淡青にし、D〜Gも白に戻す
        If cell.Formula = "" Then
            cell.Interior.Color = RGB(221, 235, 247) ' E列 → 淡青
            For i = 4 To 7 ' D～G列を白に戻す
                Me.Cells(r, i).Interior.ColorIndex = xlNone
            Next i
            GoTo SkipRow
        Else
            cell.Interior.ColorIndex = xlNone ' E列に値があれば白に戻す
        End If

        valE = Val(cell.Value)
        valH = Val(Me.Cells(r, "H").Value)

        For i = 4 To 7 ' D～G列の色判定
            With Me.Cells(r, i).Interior
                If isSensoryRow Then
                    If valE = 0 Then
                        .Color = RGB(255, 255, 0) ' 黄色（補充必要）
                    Else
                        .ColorIndex = xlNone ' 無色（補充不要）
                    End If
                Else
                    If valE < valH Then
                        .Color = RGB(255, 255, 0) ' 黄色（不足）
                    ElseIf valE = valH Then
                        .Color = RGB(144, 238, 144) ' 緑（ちょうど）
                    Else
                        .ColorIndex = xlNone ' 無色（在庫充分）
                    End If
                End If
            End With
        Next i

SkipRow:
    Next cell

    Application.EnableEvents = True
End Sub