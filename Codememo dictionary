Option Explicit

' ====== 設定 ======
Private Const WATCH_RANGE As String = "E4:E1000"   ' 監視対象範囲
Private Const COL_H As Long = 8                    ' H列

' 色設定（仕様固定）
Private Const CLR_INFO_R As Long = 221, CLR_INFO_G As Long = 235, CLR_INFO_B As Long = 247 ' 空白：薄青
Private Const CLR_WARN_R As Long = 255, CLR_WARN_G As Long = 255, CLR_WARN_B As Long = 0   ' 警告：黄色（不足/無在庫）
Private Const CLR_EQUAL_R As Long = 146, CLR_EQUAL_G As Long = 208, CLR_EQUAL_B As Long = 80 ' 一致：緑（E=H）

Private Sub Worksheet_Change(ByVal Target As Range)
    Dim rng As Range, c As Range
    Dim r As Long, i As Long
    Dim valE As Double, valH As Double
    
    On Error GoTo exit_handler
    Set rng = Intersect(Target, Me.Range(WATCH_RANGE))
    If rng Is Nothing Then Exit Sub
    
    Application.EnableEvents = False
    
    For Each c In rng.Cells
        r = c.Row
        
        ' --- 空白処理：削除・クリア時は必ず薄青に戻す ---
        If LenB(Trim$(CStr(c.Value))) = 0 Then
            ' E列：薄青
            c.Interior.Color = RGB(CLR_INFO_R, CLR_INFO_G, CLR_INFO_B)
            ' D～G：無色
            For i = 4 To 7
                Me.Cells(r, i).Interior.ColorIndex = xlNone
            Next
            GoTo next_cell   ' ★ 空白はここで終了（後続ロジックを回避）
        End If
        
        ' Eに値がある場合、まずEの色をクリア
        c.Interior.ColorIndex = xlNone
        ' D～G初期化
        For i = 4 To 7
            Me.Cells(r, i).Interior.ColorIndex = xlNone
        Next
        
        ' --- 特殊行（0/1のみ） ---
        If IsSpecialRow(r) Then
            If IsNumeric(c.Value) Then
                valE = CDbl(c.Value)
                Select Case valE
                    Case 0
                        ' 無在庫 → 黄色
                        For i = 4 To 7
                            Me.Cells(r, i).Interior.Color = RGB(CLR_WARN_R, CLR_WARN_G, CLR_WARN_B)
                        Next
                    Case 1
                        ' 有在庫 → 無色（既にクリア）
                    Case Else
                        ' 不正入力 → エラー表示
                        c.Value = "入力エラー"
                End Select
            Else
                c.Value = "入力エラー"
            End If
            GoTo next_cell   ' ★ 特殊行はここで終了（後続ロジックを回避）
        End If
        
        ' --- 通常行（E と H の比較） ---
        If IsNumeric(c.Value) Then valE = CDbl(c.Value) Else valE = 0
        valH = GetHNumericValue(r)
        
        For i = 4 To 7
            With Me.Cells(r, i).Interior
                If valE < valH Then
                    .Color = RGB(CLR_WARN_R, CLR_WARN_G, CLR_WARN_B)      ' 不足：黄色
                ElseIf valE = valH Then
                    .Color = RGB(CLR_EQUAL_R, CLR_EQUAL_G, CLR_EQUAL_B)    ' 一致：緑
                Else
                    .ColorIndex = xlNone                                   ' 過剰：無色
                End If
            End With
        Next
        
next_cell:
    Next c

exit_handler:
    Application.EnableEvents = True
End Sub

' ====== ユーティリティ ======

' 特殊行判定（名前付き範囲「SpecialRows」）
Private Function IsSpecialRow(ByVal r As Long) As Boolean
    Dim rng As Range, cell As Range
    Dim raw As String, token As Variant
    Dim a As Long, b As Long
    
    On Error GoTo no_name
    Set rng = Range("SpecialRows")
    On Error GoTo 0
    If rng Is Nothing Then Exit Function
    
    For Each cell In rng.Cells
        raw = Trim$(CStr(cell.Value))
        If Len(raw) > 0 Then
            For Each token In Split(raw, ",")
                token = Trim$(CStr(token))
                If Len(token) = 0 Then GoTo continue_token
                
                If InStr(1, token, "-", vbTextCompare) > 0 Then
                    If TryParseRange(CStr(token), a, b) Then
                        If r >= a And r <= b Then IsSpecialRow = True: Exit Function
                    End If
                ElseIf IsNumeric(token) Then
                    If CLng(token) = r Then IsSpecialRow = True: Exit Function
                End If
continue_token:
            Next token
        End If
    Next cell
    Exit Function
    
no_name:
    IsSpecialRow = False
End Function

' "m-n" 形式を a,b に変換
Private Function TryParseRange(ByVal s As String, ByRef a As Long, ByRef b As Long) As Boolean
    Dim parts() As String
    parts = Split(Replace$(s, " ", ""), "-")
    If UBound(parts) = 1 Then
        If IsNumeric(parts(0)) And IsNumeric(parts(1)) Then
            a = CLng(parts(0)): b = CLng(parts(1))
            If a > b Then
                Dim t As Long: t = a: a = b: b = t
            End If
            TryParseRange = True
        End If
    End If
End Function

' H列の比較用数値を取得
Private Function GetHNumericValue(ByVal r As Long) As Double
    Dim hCell As Range, txt As String, m As Object
    Set hCell = Me.Cells(r, COL_H)
    If hCell.MergeCells Then Set hCell = hCell.MergeArea(1, 1)
    
    If IsNumeric(hCell.Value) And Len(hCell.Value) > 0 Then
        GetHNumericValue = CDbl(hCell.Value)
    Else
        txt = CStr(hCell.Value)
        With CreateObject("VBScript.RegExp")
            .Pattern = "(\d+)"
            .Global = False
            .IgnoreCase = True
            If .Test(txt) Then
                Set m = .Execute(txt)
                GetHNumericValue = CDbl(m(0).Value)
            Else
                GetHNumericValue = 0
            End If
        End With
    End If
End Function