' ================================
' 📦 Module: modLogUtility
' ログ出力 + エラー回復支援
' ================================

Public gLogFilePath As String
Public gHasErrorOccurred As Boolean
Public gLogLocalFolder As String
Public gLogNetFolder As String

' 📌 ログ初期化（ローカル作成 → 後でコピー）
Sub InitLogger(yyyymm As String)
    On Error GoTo ErrHandler

    Dim y As String, m As String
    y = Left(yyyymm, 4)
    m = Right(yyyymm, 2)

    ' ローカルログフォルダ
    gLogLocalFolder = Environ("USERPROFILE") & "\Documents\工数ログ\" & y & "\" & m
    MkDirRecursive gLogLocalFolder

    ' ネットワークログフォルダ（あれば後でコピー）
    gLogNetFolder = "\\bbwcfs.local\share4\SBM1\SharePrj\大宮データセンター運用フォルダ\14.定例会\編集用資料\工数取得マクロ作成済\ログ\" & y & "\" & m

    ' ログファイル名
    gLogFilePath = gLogLocalFolder & "\log_" & Format(Now, "yyyymmdd_HHmmss") & ".txt"

    Open gLogFilePath For Output As #1
    Print #1, "【ログ開始】 " & Now
    Close #1
    Exit Sub

ErrHandler:
    MsgBox "ログファイルの初期化中にエラーが発生しました：" & vbCrLf & Err.Description, vbCritical
    End
End Sub

' 📌 ログ追記
Sub WriteLog(msg As String)
    On Error Resume Next
    Open gLogFilePath For Append As #1
    Print #1, "[" & Format(Now, "yyyy/mm/dd HH:MM:SS") & "] " & msg
    Close #1
End Sub

' 📌 最後にログコピー（ローカル → ネット共有）
Sub CopyLogToNetwork()
    On Error GoTo ErrHandler

    If Dir(gLogNetFolder, vbDirectory) = "" Then
        MkDirRecursive gLogNetFolder
    End If

    Dim destPath As String
    destPath = gLogNetFolder & "\" & Dir(gLogFilePath)
    FileCopy gLogFilePath, destPath

    WriteLog "✅ ログを共有フォルダへコピー完了: " & destPath
    Exit Sub

ErrHandler:
    MsgBox "⚠ ログを共有フォルダにコピーできませんでした。" & vbCrLf & _
           "ローカルログは以下に保存されています：" & vbCrLf & gLogFilePath, vbExclamation
    WriteLog "❌ ログの共有コピー失敗: " & Err.Description
End Sub

' 📌 フォルダ存在チェック＋再帰的作成
Sub MkDirRecursive(ByVal path As String)
    Dim tempPath As String, folders() As String
    Dim i As Integer
    folders = Split(path, "\")
    tempPath = folders(0)
    For i = 1 To UBound(folders)
        tempPath = tempPath & "\" & folders(i)
        If Len(Dir(tempPath, vbDirectory)) = 0 Then
            MkDir tempPath
        End If
    Next i
End Sub

' 📌 エラー処理 + 中断 + ログ
Sub ErrorRollback(Optional ByVal stepName As String = "", Optional ByVal errMsg As String = "")
    gHasErrorOccurred = True

    If stepName <> "" Then WriteLog "❌ [" & stepName & "] でエラー： " & errMsg
    If errMsg <> "" Then
        MsgBox "エラーが発生しました：" & vbCrLf & errMsg & vbCrLf & vbCrLf & _
               "ログを確認してください。" & vbCrLf & gLogFilePath, vbCritical, "処理中断"
    End If

    ' すべての一時ファイルなど閉じる処理をここに追記してもOK
    End
End Sub