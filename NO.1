Option Explicit

' ====== 設定 ======
Private Const WATCH_RANGE As String = "E4:E1000"   ' 監視対象範囲（E列のみ）
Private Const COL_H As Long = 8                    ' H列

' 色設定（仕様固定）
Private Const CLR_INFO_R As Long = 221, CLR_INFO_G As Long = 235, CLR_INFO_B As Long = 247   ' 空白：薄青（入力未完了の注意）
Private Const CLR_WARN_R As Long = 255, CLR_WARN_G As Long = 255, CLR_WARN_B As Long = 0     ' 警告/不足：黄色
Private Const CLR_EQUAL_R As Long = 146, CLR_EQUAL_G As Long = 208, CLR_EQUAL_B As Long = 80 ' 一致：緑（E=H）

' ===========================================================================================
' 仕様概要
' ・特殊行：命名範囲「SpecialRows」（ブック級）を読み込み。未設定/空なら固定集合へフォールバック。
'    └ E=0 → D～G：黄色、E=1 → 無色、その他 → 無色（通常比較は行わない）
' ・通常行：E<H → 黄色、E=H → 緑、E>H → 無色
' ・E 空欄：E=薄青、D/F/G=無色（即時終了）
' ===========================================================================================
Private Sub Worksheet_Change(ByVal Target As Range)
    Dim rng As Range, c As Range
    Dim r As Long, i As Long
    Dim valE As Double, valH As Double
    Dim s As String
    Dim sp As Object  ' Scripting.Dictionary（特殊行セット）

    On Error GoTo exit_handler
    Set rng = Intersect(Target, Me.Range(WATCH_RANGE))
    If rng Is Nothing Then Exit Sub

    ' 特殊行セットをロード（設定優先→固定フォールバック）
    Set sp = LoadSpecialRowsSet()

    Application.EnableEvents = False

    For Each c In rng.Cells
        r = c.Row

        ' === 空白：E=薄青、D/F/G=無色（Eは触らない） ===
        If LenB(Trim$(CStr(c.Value))) = 0 Then
            Me.Cells(r, 4).Interior.ColorIndex = xlNone ' D
            Me.Cells(r, 6).Interior.ColorIndex = xlNone ' F
            Me.Cells(r, 7).Interior.ColorIndex = xlNone ' G
            With c.Interior
                .Pattern = xlSolid
                .PatternColorIndex = xlAutomatic
                .Color = RGB(CLR_INFO_R, CLR_INFO_G, CLR_INFO_B) ' 221,235,247
                .TintAndShade = 0
                .PatternTintAndShade = 0
            End With
            GoTo next_cell
        End If

        ' 初期化：E/D～G を一旦無色に
        c.Interior.ColorIndex = xlNone
        For i = 4 To 7
            Me.Cells(r, i).Interior.ColorIndex = xlNone
        Next

        ' === 特殊行 ===
        If sp.Exists(CStr(r)) Then
            ' 表示テキストを軽く正規化して "0"/"1" を判定（エラー表示は行わない）
            s = Normalize01(CStr(c.Text))
            If s = "0" Then
                For i = 4 To 7
                    Me.Cells(r, i).Interior.Color = RGB(CLR_WARN_R, CLR_WARN_G, CLR_WARN_B) ' 255,255,0
                Next
                GoTo next_cell   ' 通常行ロジックを回避
            ElseIf s = "1" Then
                GoTo next_cell   ' 無色のまま・通常行ロジックを回避
            Else
                GoTo next_cell   ' 無色のまま・通常行ロジックを回避
            End If
        End If

        ' === 通常行：E と H の比較 ===
        If IsNumeric(c.Value) Then valE = CDbl(c.Value) Else valE = 0
        valH = GetHNumericValue(r)

        For i = 4 To 7
            With Me.Cells(r, i).Interior
                If valE < valH Then
                    .Color = RGB(CLR_WARN_R, CLR_WARN_G, CLR_WARN_B)      ' 不足：黄色
                ElseIf valE = valH Then
                    .Color = RGB(CLR_EQUAL_R, CLR_EQUAL_G, CLR_EQUAL_B)    ' 一致：緑
                Else
                    .ColorIndex = xlNone                                   ' 過剰：無色
                End If
            End With
        Next

next_cell:
    Next c

exit_handler:
    Application.EnableEvents = True
End Sub

' ====== 特殊行セットの読込（設定優先→固定フォールバック） ======
Private Function LoadSpecialRowsSet() As Object
    Dim dict As Object: Set dict = CreateObject("Scripting.Dictionary")
    Dim rng As Range, cell As Range
    Dim raw As String, token As Variant
    Dim a As Long, b As Long, i As Long
    Dim loaded As Boolean

    ' ブック級の名前「SpecialRows」→ シート級 → 取得不可なら Nothing
    Set rng = GetSpecialRowsRange()

    If Not rng Is Nothing Then
        For Each cell In rng.Cells
            raw = NormalizeDelimiters(CStr(cell.Text)) ' Text で取得
            If Len(raw) > 0 Then
                For Each token In Split(raw, ",")
                    token = Trim$(CStr(token))
                    If Len(token) = 0 Then GoTo continue_token
                    If InStr(1, token, "-", vbTextCompare) > 0 Then
                        If TryParseRange(token, a, b) Then
                            For i = a To b
                                If Not dict.Exists(CStr(i)) Then dict.Add CStr(i), True
                            Next
                            loaded = True
                        End If
                    ElseIf IsNumeric(token) Then
                        If Not dict.Exists(CStr(CLng(token))) Then dict.Add CStr(CLng(token)), True
                        loaded = True
                    End If
continue_token:
                Next token
            End If
        Next cell
    End If

    ' 何も読めなかった場合：固定集合にフォールバック
    If Not loaded Then
        AddFixedSpecialRows dict
    End If

    Set LoadSpecialRowsSet = dict
End Function

' 固定の特殊行を dict に追加：10-15, 31-47, 51, 56-58, 67-68, 72, 89
Private Sub AddFixedSpecialRows(ByVal dict As Object)
    Dim i As Long
    For i = 10 To 15: If Not dict.Exists(CStr(i)) Then dict.Add CStr(i), True
    Next
    For i = 31 To 47: If Not dict.Exists(CStr(i)) Then dict.Add CStr(i), True
    Next
    If Not dict.Exists("51") Then dict.Add "51", True
    For i = 56 To 58: If Not dict.Exists(CStr(i)) Then dict.Add CStr(i), True
    Next
    For i = 67 To 68: If Not dict.Exists(CStr(i)) Then dict.Add CStr(i), True
    Next
    If Not dict.Exists("72") Then dict.Add "72", True
    If Not dict.Exists("89") Then dict.Add "89", True
End Sub

' 名前「SpecialRows」の参照範囲（ブック優先 → シート）。無ければ Nothing
Private Function GetSpecialRowsRange() As Range
    On Error Resume Next
    If Not ThisWorkbook Is Nothing Then
        If Not ThisWorkbook.Names("SpecialRows") Is Nothing Then
            Set GetSpecialRowsRange = ThisWorkbook.Names("SpecialRows").RefersToRange
            Exit Function
        End If
    End If
    Set GetSpecialRowsRange = Range("SpecialRows")
    On Error GoTo 0
End Function

' ====== 補助関数 ======

' "m-n" を a,b にパース（m>n は入れ替え、m<=n に正規化）
Private Function TryParseRange(ByVal s As String, ByRef a As Long, ByRef b As Long) As Boolean
    Dim parts() As String
    s = Replace$(s, " ", "")
    parts = Split(s, "-")
    If UBound(parts) = 1 Then
        If IsNumeric(parts(0)) And IsNumeric(parts(1)) Then
            a = CLng(parts(0)): b = CLng(parts(1))
            If a > b Then
                Dim t As Long: t = a: a = b: b = t
            End If
            TryParseRange = True
        End If
    End If
End Function

' H列の比較用数値を取得（結合セル対応・文字列から最初の数値を抽出）
Private Function GetHNumericValue(ByVal r As Long) As Double
    Dim hCell As Range, txt As String, m As Object
    Set hCell = Me.Cells(r, COL_H)
    If hCell.MergeCells Then Set hCell = hCell.MergeArea(1, 1) ' 結合セルの左上セル

    If IsNumeric(hCell.Value) And Len(hCell.Value) > 0 Then
        GetHNumericValue = CDbl(hCell.Value)
    Else
        txt = CStr(hCell.Value)
        With CreateObject("VBScript.RegExp")
            .Pattern = "(\d+)"
            .Global = False
            .IgnoreCase = True
            If .Test(txt) Then
                Set m = .Execute(txt)
                GetHNumericValue = CDbl(m(0).Value)
            Else
                GetHNumericValue = 0
            End If
        End With
    End If
End Function

' 0/1 判定用の軽量正規化（全角→半角、空白除去）
Private Function Normalize01(ByVal s As String) As String
    Dim i As Long, ch As String, code As Long, out As String
    s = Trim$(s)
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        code = AscW(ch)
        If code >= &HFF10 And code <= &HFF19 Then ' 全角０〜９
            ch = ChrW(code - &HFEE0)
        End If
        out = out & ch
    Next i
    out = Replace$(out, " ", "")
    out = Replace$(out, vbTab, "")
    Normalize01 = out
End Function

' 区切り/ダッシュ類を正規化（，、→, ／ ー－—–−→- ／ 全角空白除去）
Private Function NormalizeDelimiters(ByVal s As String) As String
    s = Replace$(s, "，", ",")
    s = Replace$(s, "、", ",")
    s = Replace$(s, "ー", "-")
    s = Replace$(s, "－", "-")
    s = Replace$(s, "—", "-")
    s = Replace$(s, "–", "-")
    s = Replace$(s, "−", "-")
    s = Trim$(s)
    s = Replace$(s, vbTab, "")
    s = Replace$(s, ChrW(&H3000), "") ' 全角スペース
    NormalizeDelimiters = s
End Function