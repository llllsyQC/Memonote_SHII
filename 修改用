' === STEP5: 稼働率計算 ============================
Call WriteLog("STEP5: 稼働率計算 開始")

Dim totalTime As Double, baseTime As Double, 稼働率 As Double
Dim rng As Range, cell As Range
Dim ws工数 As Worksheet

On Error GoTo ERR_HANDLER_STEP5

Set ws工数 = ThisWorkbook.Sheets("工数取得-都度対応項目（時間）")

Call WriteLog("STEP5-1: 範囲 EP10:EP64 読み込み開始")

' 安全に範囲設定
Set rng = ws工数.Range("EP10:EP64")

Call WriteLog("STEP5-2: 合計処理開始")

' 合計計算（1単位 = 時間単位, Excel 時間 * 24 = 小数時間）
totalTime = 0
For Each cell In rng
    If IsNumeric(cell.Value) Then
        totalTime = totalTime + cell.Value
    End If
Next cell
totalTime = totalTime * 24

Call WriteLog("STEP5-3: H10 取得 → 基準時間")
baseTime = ws工数.Range("H10").Value * 24

Call WriteLog("STEP5-4: 計算実行 → totalTime=" & totalTime & " / baseTime=" & baseTime)

If IsNumeric(totalTime) And IsNumeric(baseTime) And baseTime <> 0 Then
    稼働率 = (totalTime / baseTime) * 100

    MsgBox _
        "EP10:EP64 合計 = " & Format(totalTime, "0.00") & " 時間" & vbCrLf & _
        "H10 = " & Format(baseTime, "0.00") & " 時間" & vbCrLf & _
        "稼働率 = " & Format(稼働率, "0.0") & " %", _
        vbInformation, "稼働率確認"

    If 稼働率 < 95 Or 稼働率 > 100 Then
        MsgBox "稼働率が95～100%の範囲外です。手動で確認してください。", vbExclamation
        Call WriteLog("STEP5: 稼働率計算エラー → 範囲外 " & 稼働率)
    End If
Else
    ' 数値が無効だった場合
    Call WriteLog("STEP5: 稼働率計算エラー → baseTime=" & baseTime & ", totalTime=" & totalTime)
    Call ErrorRollback("STEP5: 稼働率計算エラー：計算値が無効です。baseTime=" & baseTime & ", totalTime=" & totalTime)
    Exit Sub
End If

Call WriteLog("STEP5: 稼働率計算 完了")
Exit Sub

' === エラーハンドラ ============================
ERR_HANDLER_STEP5:
Call ErrorRollback("STEP5: 未知のエラー発生 → " & Err.Description)
Exit Sub