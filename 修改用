Sub CopyLogToNetwork()
    On Error GoTo ErrHandler

    ' ネットワークフォルダがなければ作成
    If Dir(gLogNetFolder, vbDirectory) = "" Then
        MkDirRecursive gLogNetFolder
    End If

    Dim destPath As String
    destPath = gLogNetFolder & "\" & Dir(gLogFilePath)

    ' ADODB.Stream を使ってコピー（FileCopy の代替）
    Dim streamIn As Object, streamOut As Object
    Set streamIn = CreateObject("ADODB.Stream")
    Set streamOut = CreateObject("ADODB.Stream")

    streamIn.Type = 1 ' バイナリ
    streamIn.Open
    streamIn.LoadFromFile gLogFilePath

    streamOut.Type = 1
    streamOut.Open
    streamIn.Position = 0
    streamIn.CopyTo streamOut
    streamOut.SaveToFile destPath, 2 ' 2 = 上書き

    streamIn.Close
    streamOut.Close
    Set streamIn = Nothing
    Set streamOut = Nothing

    WriteLog "✅ ログの共有フォルダコピー完了：" & destPath
    Exit Sub

ErrHandler:
    MsgBox "⚠️ ログのネットワークコピーに失敗しました。" & vbCrLf & _
           "ファイルはローカルに保存されています：" & vbCrLf & gLogFilePath, vbExclamation
    WriteLog "❌ ログのコピー失敗：" & Err.Description
End Sub