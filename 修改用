Sub Step6_保存処理(yyyymm As String)
    Dim pathSave As String
    pathSave = "..." '你的路径

    Application.DisplayAlerts = False
    ThisWorkbook.SaveAs Filename:=pathSave & "月次工数集計シート" & yyyymm & ".xlsm", _
        FileFormat:=xlOpenXMLWorkbookMacroEnabled
    Application.DisplayAlerts = True

    MsgBox "月次工数集計シートを保存しました：" & yyyymm
    MsgBox "工数取得ver.5.2（大宮）転記開始"

    ' === 保存後、フォルダを開く ===
    Dim folderPath1 As String
    folderPath1 = Left(pathSave, InStrRev(pathSave, "¥") - 1)
    ThisWorkbook.FollowHyperlink folderPath1
End Sub

Call Step6_保存処理(yyyymm)