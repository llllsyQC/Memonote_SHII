' --- STEP5: 稼働率計算・チェック ---
WriteLog "STEP5: 稼働率計算 開始"

Dim rng As Range, cell As Range
Dim totalTime As Double, baseTime As Double, 稼働率 As Double

On Error GoTo ERR_HANDLER

WriteLog "STEP5-1: 範囲 EP10:EP64 読み込み開始"
Set rng = ThisWorkbook.Sheets("工数取得-都度対応項目（時間）").Range("EP10:EP64")

WriteLog "STEP5-2: 合計計算開始"
totalTime = 0
For Each cell In rng
    If IsNumeric(cell.Value) Then totalTime = totalTime + cell.Value
Next cell
WriteLog "STEP5-3: totalTime 合計完了 → " & totalTime

WriteLog "STEP5-4: H10 読み取り"
baseTime = ThisWorkbook.Sheets("工数取得-都度対応項目（時間）").Range("H10").Value
WriteLog "STEP5-4: baseTime 値 → " & baseTime

WriteLog "STEP5-5: 稼働率 計算開始"
If IsNumeric(totalTime) And IsNumeric(baseTime) And baseTime <> 0 Then
    稼働率 = (totalTime * 24) / (baseTime * 24) * 100

    MsgBox "EP10:EP64 合計 = " & Format(totalTime * 24, "0.00") & " 時間" & vbCrLf & _
           "H10 = " & Format(baseTime * 24, "0.00") & " 時間" & vbCrLf & _
           "稼働率 = " & Format(稼働率, "0.0") & "%", vbInformation, "稼働率確認"

    If 稼働率 < 95 Or 稼働率 > 100 Then
        MsgBox "⚠ 稼働率が95%～100%の範囲外です。手動で確認してください。", vbExclamation
        WriteLog "STEP5-6: 稼働率警告 → 値=" & 稼働率
    End If
Else
    Call ErrorRollback("STEP5: 稼働率計算エラー：baseTimeまたはtotalTimeが無効。baseTime=" & baseTime & " / totalTime=" & totalTime)
    Exit Sub
End If

WriteLog "STEP5-6: 稼働率計算 完了 → " & Format(稼働率, "0.0") & "%"
Exit Sub

' === エラーハンドラ ===
ERR_HANDLER:
    Call ErrorRollback("STEP5: 未知のエラー発生 → " & Err.Description)
    Exit Sub