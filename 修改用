' --- 稼働率計算・チェック ---
Dim totalTime As Double, baseTime As Double, 稼働率 As Double
Dim rng As Range, cell As Range

Set rng = ThisWorkbook.Sheets("工数取得-都度対応項目（時間）").Range("EP10:EP64")

totalTime = 0
For Each cell In rng
    If IsNumeric(cell.Value) Then
        totalTime = totalTime + cell.Value
    Else
        If Not IsEmpty(cell.Value) Then
            WriteLog "⚠️ 非数値セル検出 (EP列): " & cell.Address & " = " & cell.Text
        End If
    End If
Next cell
totalTime = totalTime * 24

baseTime = ThisWorkbook.Sheets("工数取得-都度対応項目（時間）").Range("H10").Value * 24

WriteLog "DEBUG: totalTime = " & totalTime
WriteLog "DEBUG: baseTime = " & baseTime

If IsNumeric(totalTime) And IsNumeric(baseTime) And baseTime <> 0 Then
    稼働率 = (totalTime / baseTime) * 100
    MsgBox "EP10:EP64 合計 = " & Format(totalTime, "0.00") & " 時間" & vbCrLf & _
           "H10 = " & Format(baseTime, "0.00") & " 時間" & vbCrLf & _
           "稼働率 = " & Format(稼働率, "0.0") & " %", vbInformation, "稼働率確認"
    WriteLog "STEP5: 稼働率 = " & Format(稼働率, "0.0") & "%"
    
    If 稼働率 < 95 Or 稼働率 > 100 Then
        MsgBox "稼働率が95%～100%の範囲外です。手動で確認してください。", vbExclamation
        WriteLog "⚠️ 稼働率警告: baseTime=" & baseTime & ", totalTime=" & totalTime
    End If
Else
    Call ErrorRollback("STEP5: 稼働率計算エラー - baseTime=" & baseTime & " / totalTime=" & totalTime)
    Exit Sub
End If

WriteLog "STEP5: 稼働率計算 完了"