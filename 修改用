'===============================
' 📌 STEP5: 稼働率計算（安全対策済）
'===============================
Sub Step5_稼働率計算(yyyymm As String)

    On Error GoTo ERR_HANDLER
    Call WriteLog("STEP5: 稼働率計算 開始")

    Dim ws工数 As Worksheet
    Dim sheetName As String: sheetName = "工数取得-都度対応項目（時間）"

    '=== 📌 シート存在確認 ===
    Dim found As Boolean: found = False
    Dim sh As Worksheet
    For Each sh In ThisWorkbook.Worksheets
        If sh.Name = sheetName Then
            Set ws工数 = sh
            found = True
            Exit For
        End If
    Next

    If Not found Then
        Call ErrorRollback("STEP5: 対象シートが見つかりません → " & sheetName)
        Exit Sub
    End If

    '=== 📌 データ取得 ===
    Dim rng As Range
    Set rng = ws工数.Range("EP10:EP64")

    Dim totalTime As Double, baseTime As Double, 稼働率 As Double
    totalTime = WorksheetFunction.Sum(rng) * 24
    baseTime = ws工数.Range("H10").Value * 24

    Call WriteLog("STEP5: 範囲 EP10:EP64 読み込み完了 → 合計=" & totalTime & ", H10=" & baseTime)

    If IsNumeric(totalTime) And IsNumeric(baseTime) And baseTime <> 0 Then
        稼働率 = (totalTime / baseTime) * 100

        MsgBox "EP10:EP64 合計 = " & Format(totalTime, "0.00") & " 時間" & vbCrLf & _
               "H10 = " & Format(baseTime, "0.00") & " 時間" & vbCrLf & _
               "稼働率 = " & Format(稼働率, "0.0") & " %", vbInformation, "稼働率確認"

        If 稼働率 < 95 Or 稼働率 > 100 Then
            MsgBox "稼働率が95%〜100%の範囲外です。手動で確認してください。", vbExclamation
            Call WriteLog("STEP5: 稼働率範囲外（" & Format(稼働率, "0.0") & " %）")
        End If

    Else
        Call ErrorRollback("STEP5: 計算値が無効です。baseTime=" & baseTime & ", totalTime=" & totalTime)
        Exit Sub
    End If

    Call WriteLog("STEP5: 稼働率計算 完了")
    Exit Sub

ERR_HANDLER:
    Call ErrorRollback("STEP5: 未知のエラー発生 → " & Err.Description)
End Sub