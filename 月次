' ================================
' Module: modLogUtility
' ローカルログ出力 + エラー回復支援(Step対応)
' ================================

Public gLogFilePath As String
Public gHasErrorOccurred As Boolean

' 初期化: ログファイル準備 (ローカルに保存)
Sub InitLogger(yyyymm As String)
    Dim folderPath As String
    folderPath = Environ("USERPROFILE") & "\Documents\工数ログ\" & Left(yyyymm, 4) & "\" & Right(yyyymm, 2)

    MkDirRecursive folderPath

    gLogFilePath = folderPath & "\log_" & Format(Now, "yyyymmdd_HHmmss") & ".txt"

    Open gLogFilePath For Output As #1
    Print #1, "[ログ開始]" & Now
    Close #1
End Sub

' ステップ付きログ追記
Sub WriteLogStep(stepCode As String, msg As String)
    On Error Resume Next
    Open gLogFilePath For Append As #1
    Print #1, "[" & Format(Now, "yyyy/mm/dd HH:MM:SS") & "] " & stepCode & " ？ " & msg
    Close #1
End Sub

' 通常ログ追記(補助的に使用可)
Sub WriteLog(msg As String)
    On Error Resume Next
    Open gLogFilePath For Append As #1
    Print #1, "[" & Format(Now, "yyyy/mm/dd HH:MM:SS") & "] " & msg
    Close #1
End Sub

' フォルダ存在チェック + 再帰作成
Sub MkDirRecursive(ByVal path As String)
    Dim tempPath As String, folders() As String
    Dim i As Integer
    folders = Split(path, "\")
    tempPath = folders(0)
    For i = 1 To UBound(folders)
        tempPath = tempPath & "\" & folders(i)
        If Dir(tempPath, vbDirectory) = "" Then MkDir tempPath
    Next i
End Sub

' グローバルロールバック処理
Sub ErrorRollback(Optional ByVal stepCode As String = "", Optional ByVal errMsg As String = "")
    gHasErrorOccurred = True
    If errMsg <> "" Then
        If stepCode <> "" Then
            WriteLogStep stepCode, "エラー発生:" & errMsg
        Else
            WriteLog "エラー発生:" & errMsg
        End If
    End If
    MsgBox "エラーが発生しました。" & vbCrLf & errMsg & vbCrLf & "ログを確認してください。", vbCritical, "処理中断"
End Sub

' ================================
' Module: modMain
' 工数集計_自動処理の起点
' ================================

Sub 工数集計_自動処理()
    On Error GoTo ERR_HANDLER
    Dim 年 As String, 月 As String, yyyymm As String
    Dim pathDaily As String

    年 = InputBox("年を入力してください(例:2025)")
    If 年 = "" Then MsgBox "年の入力が必要です。": Exit Sub
    If Not IsNumeric(年) Or Len(年) <> 4 Or Val(年) < 2000 Or Val(年) > 2100 Then
        MsgBox "正しい年を4桁で入力してください(例:2025)", vbExclamation
        Exit Sub
    End If

    月 = InputBox("月を入力してください(例:01)")
    If 月 = "" Then MsgBox "月の入力が必要です。": Exit Sub
    If Not IsNumeric(月) Or Val(月) < 1 Or Val(月) > 12 Then
        MsgBox "正しい月を1〜12の範囲で入力してください", vbExclamation
        Exit Sub
    End If

    If Len(月) = 1 Then 月 = "0" & 月
    yyyymm = 年 & 月

    ' === ログ初期化 ===
    Call InitLogger(yyyymm)
    Call WriteLog("工数集計 開始 (年月: " & yyyymm & ")")

    ' === フォルダ生成 ===
    pathDaily = GetTargetFolderPath(年, 月)
    If Dir(pathDaily, vbDirectory) = "" Then
        Call ErrorRollback("フォルダが見つかりません: " & pathDaily)
        Exit Sub
    End If
    Call WriteLog("対象フォルダ存在確認:" & pathDaily)

    ' === メイン処理 ===
    Call Import_AllSources(yyyymm, 年, 月, pathDaily)
    Call Copy_WorkHours_By工数番号(yyyymm, 年, 月)
    Call Step5_稼働率計算(yyyymm)
    Call Step6_保有処理(yyyymm)
    Call Process_Ver52(yyyymm, 年, 月)

    Call WriteLog("工数集計 完了：" & yyyymm)
    MsgBox "工数集計が完了しました！", vbInformation

    Exit Sub

ERR_HANDLER:
    Call ErrorRollback("予期しないエラー:" & Err.Description)
End Sub
Function GetTargetFolderPath(年 As String, 月 As String) As String
    Dim basePath As String
    basePath = "\\bbwcfs.local\share4\SBM1\SharePrj\六堂データセンター運用フォルダ\06．日報\06.50 定時_工数集計\202504工数ルール改定\マクロ修正中\過去分"
    GetTargetFolderPath = basePath & "\" & 年 & "年\" & 月 & "月\"
End Function

' ================================
' Module: modImport
' データ読み込みと工数転記処理
' ================================
Sub Import_AllSources(yyyymm As String, 年 As String, 月 As String, pathDaily As String)
    On Error GoTo ERR_HANDLER
    Dim fileName1 As String, fileName2 As String, fileName4 As String
    Dim wb1 As Workbook, wb2 As Workbook, wb4 As Workbook

    ' ①定時作業チェックシート読込み ===
    ' ①定時チェック
    fileName1 = Dir(pathDaily & "\①工数集計_定時作業チェックシート_*" & yyyymm & "*.xlsx")
    If fileName1 <> "" Then
        Set wb1 = Workbooks.Open(pathDaily & "\" & fileName1)
        wb1.Worksheets("定時作業工数詳細").Columns.EntireColumn.Hidden = False
        wb1.Worksheets("定時作業工数詳細").Rows.EntireRow.Hidden = False
        ActiveWindow.FreezePanes = False

        wb1.Worksheets("定時作業工数詳細").Range("M4:AQ57").Copy
        ThisWorkbook.Worksheets("定(日)").Range("B3").PasteSpecial Paste:=xlPasteValues

        wb1.Worksheets("定時作業工数詳細").Range("M59:AQ112").Copy
        ThisWorkbook.Worksheets("定(夜)").Range("B3").PasteSpecial Paste:=xlPasteValues
        Application.DisplayAlerts = False
        wb1.Close
    End If

    ' ②定時外
    fileName2 = Dir(pathDaily & "\②工数集計_定時外_*" & yyyymm & ".xlsx")
    If fileName2 <> "" Then
        Set wb2 = Workbooks.Open(pathDaily & fileName2)
        wb2.Worksheets("②集計シート").Range("F4:BO57").Copy
        ThisWorkbook.Worksheets("定時外").Range("F7").PasteSpecial xlPasteValues
        wb2.Close False
    Else
        MsgBox "②ファイルが見つかりません", vbExclamation
    End If

    ' ④日報
    fileName4 = Dir(pathDaily & "\④工数集計_日報_*" & yyyymm & "*.xlsx")
    If fileName4 <> "" Then
        Set wb4 = Workbooks.Open(pathDaily & "\" & fileName4)
        wb4.Worksheets("日報").Range("F7:LC60").Copy
        ThisWorkbook.Worksheets("日報").Range("F7").PasteSpecial xlPasteValues
        wb4.Close False
    Else
        MsgBox "④ファイルが見つかりません", vbExclamation
    End If

    ' 年月を書き込む
    With ThisWorkbook.Worksheets("工数取得-都度対応項目（時間）")
        .Range("I5").Value = 年
        .Range("I8").Value = 月
    End With
    WriteLog "年月情報記入完了"

    Exit Sub
ERR_HANDLER:
    Call ErrorRollback("Import_AllSourcesでエラー:" & Err.Description)
End Sub

Sub Copy_WorkHours_By工数番号(yyyymm As String, 年 As String, 月 As String)
    On Error GoTo ERR_HANDLER

    Call WriteLog("STEP1：工数取得処理 開始")

    Dim wsSrc As Worksheet, wsDest As Worksheet
    Dim 工数Map As Object
    Dim i As Integer, srcRow As Long
    Dim 工数番号 As String
    Dim destRow As Long
    Dim dayBaseCol As Long
    Dim colOffset As Long
    Dim 日勤列 As Long, 夜勤列 As Long
    Dim 日付判定セル As Range
    Dim pathSave As String
    Dim alertState As Boolean
    alertState = Application.DisplayAlerts

    Set wsSrc = ThisWorkbook.Worksheets("0消し(最終)")
    Set wsDest = ThisWorkbook.Worksheets("工数取得-都度対応項目(時間)")
    Set 工数Map = CreateObject("Scripting.Dictionary")

    ' === STEP2：工数番号マッピング ===
    Call WriteLog("STEP2：工数番号マッピング開始")
    For destRow = 11 To 64
        工数番号 = Trim(CStr(wsDest.Cells(destRow, "I").Value))
        If 工数番号 <> "" Then
            工数Map(工数番号) = destRow
        End If
    Next
    Call WriteLog("STEP2：工数番号マッピング完了")

    ' === STEP3：各日付に対するデータ貼付 ===
    Call WriteLog("STEP3：日別データ貼付開始")
    For i = 0 To 30

        ' 判断平日 or 休日
        Set 日付判定セル = wsDest.Cells(11, 4 * i + 15)    ' 第一天 ＝ O列 = 列15

        If 日付判定セル.DisplayFormat.Interior.ColorIndex = xlNone Then
            ' 休日 → 从 R/S 開始(偏移2)
            colOffset = 2
        Else
            ' 平日 → 从 P/Q 開始(偏移0)
            colOffset = 0
        End If

        ' 起始列判別と貼付
        dayBaseCol = 4 * i + 15 + colOffset

        ' 0消中からデータ獲得(E6:E59)
        For srcRow = 6 To 59
            工数番号 = Trim(CStr(wsSrc.Cells(srcRow, "E").Value))

            If 工数Map.exists(工数番号) Then
                destRow = 工数Map(工数番号)

                ' 來源列：F列=6
                 日勤列 = 2 * i + 6
                 夜勤列 = 2 * i + 7

                ' 貼付日勤数据
                With wsDest.Cells(destRow, dayBaseCol)
                    .NumberFormat = "h:mm"
                    .Value = wsSrc.Cells(srcRow, 日勤列).Value
                End With

                ' 貼付夜勤数据
                With wsDest.Cells(destRow, dayBaseCol + 1)
                    .NumberFormat = "h:mm"
                    .Value = wsSrc.Cells(srcRow, 夜勤列).Value
                End With

            End If
        Next srcRow
    Next i
    Call WriteLog("STEP3：日別データ貼付完了")

    ' === STEP4：勤務表&残業取得 ===
    Call WriteLog("STEP4：時間集計データ取得 開始")

    ' ========= 填入H11、H15、H19、H23 =========

    Dim wbSource As Workbook, wsSource As Worksheet
    Dim y As Integer: y = CInt(Left(yyyymm, 4))
    Dim m As Integer: m = CInt(Right(yyyymm, 2))
    Dim fiscalYear As String
    If m >= 4 Then
        fiscalYear = CStr(y)
    Else
        fiscalYear = CStr(y - 1)
    End If

    ' --- ① 勤務割表取得（H11 / H19） ---
    Dim pathShiftBase As String
    pathShiftBase = "\\bbwcfs.local\share4\SBM1\SharePrj\大宮データセンター運用フォルダ\05．SBM提出物\シフト表\99．大宮勤怠作成自動化ファイル\勤務割表完了月分\" & fiscalYear & "年度\"

    Dim fileNameShift As String
    fileNameShift = Dir(pathShiftBase & "【大宮】" & y & "年" & Format(m, "00") & "月勤務割表*.xlsm")

    If fileNameShift = "" Then
        MsgBox "勤務割表ファイルが見つかりません。" & vbCrLf & pathShiftBase, vbCritical
        Exit Sub
    End If

    Set wbSource = Workbooks.Open(pathShiftBase & fileNameShift, ReadOnly:=True)
    Dim cell As Range, rng As Range
    Set rng = wbSource.Sheets(1).UsedRange ' 全体走査

    Dim valH10 As Variant, valH18 As Variant

    For Each cell In rng
        If cell.Value = "総勤務時間" Then
            valH10 = cell.Offset(0, 1).Value
        ElseIf cell.Value = "総平日日勤時間" Then
            valH18 = cell.Offset(0, 1).Value
        End If
    Next cell
    wbSource.Close False

    ' --- ② 残業時間管理表取得（H15 / H23） ---
    Dim pathOvertime As String
    pathOvertime = "\\bbwcfs.local\share4\SBM1\SharePrj\大宮データセンター運用フォルダ\06．日報\06.50 定時_工数集計\202504工数ルール改定\マクロ修正中\工数データ提出用加工\"

    Dim wbOT As Workbook, wsOT As Worksheet
    Set wbOT = Workbooks.Open(pathOvertime & "残業時間管理表.xlsx", ReadOnly:=True)

    Dim sheetName As String
    sheetName = yyyymm & "残業時間"

    On Error Resume Next
    Set wsOT = wbOT.Sheets(sheetName)
    On Error GoTo 0

    If wsOT Is Nothing Then
        MsgBox "残業時間管理表のシートが見つかりません:" & sheetName, vbCritical
        wbOT.Close False
        Exit Sub
    End If

    Dim valH14 As Variant, valH22 As Variant
    valH14 = wsOT.Range("AL4").Value
    valH22 = wsOT.Range("AO4").Value
    wbOT.Close False

    ' --- 写入本工作簿 ---
    With ThisWorkbook.Sheets("工数取得-都度対応項目（時間）")
        .Range("H10").NumberFormat = "[h]:mm"
        .Range("H10").Value = valH10

        .Range("H14").NumberFormat = "[h]:mm"
        .Range("H14").Value = valH14

        .Range("H18").NumberFormat = "[h]:mm"
        .Range("H18").Value = valH18

        .Range("H22").NumberFormat = "[h]:mm"
        .Range("H22").Value = valH22
    End With
    Call WriteLog("STEP4：時間集計データ取得 完了")
    Exit Sub

ERR_HANDLER:
    Call ErrorRollback("Copy_WorkHours_By工数番号 でエラー: " & Err.Description)

End Sub

'====================================
'STEP5：稼働率計算
'==============================
Sub Step5_稼働率計算(yyyymm As String)

    On Error GoTo ERR_HANDLER
    Call WriteLog("STEP5：稼働率 開始")

    Dim ws工数 As Worksheet
    Dim sheetName As String: sheetName = "工数取得-都度対応項目（時間）"

    '=== シート存在確認 ===
	  Dim found As Boolean: found = False
    Dim sh As Worksheet
    For Each sh In ThisWorkbook.Worksheets
        If sh.Name = sheetName Then
            Set ws工数 = sh
            found = True
            Exit For
        End If
    Next

    If Not found Then
        Call ErrorRollback("STEP5：対象シートが見つかりません → " & sheetName)
	      Exit Sub
    End If

    '=== データ取得 ===
    Dim rng As Range
    Set rng = ws工数.Range("EP10:EP64")

    Dim totalTime As Double, baseTime As Double, 稼働率 As Double
    totalTime = WorksheetFunction.Sum(rng) * 24
    baseTime = ws工数.Range("H10").Value * 24

    Call WriteLog("STEP5：範囲 EP10:EP64 読み込み完了 → 合計=" & totalTime & ", H10=" & baseTime)

    If IsNumeric(totalTime) And IsNumeric(baseTime) And baseTime <> 0 Then
        稼働率 = (totalTime / baseTime) * 100

        MsgBox "EP10:EP64 合計 = " & Format(totalTime, "0.00") & " 時間" & vbCrLf & _
               "H10 = " & Format(baseTime, "0.00") & " 時間" & vbCrLf & _
               "稼働率 = " & Format(稼働率, "0.0") & " %", vbInformation, "稼働率確認"

        If 稼働率 < 95 Or 稼働率 > 100 Then
            MsgBox "稼働率が95〜100%の範囲外です。手動で確認してください。", vbExclamation
            Call WriteLog("STEP5：稼働率範囲外 (" & Format(稼働率, "0.0") & " %)")
        End If
    Else
        Call ErrorRollback("STEP5：計算値が無効です。baseTime=" & baseTime & ", totalTime=" & totalTime)
    Exit Sub
End If

Call WriteLog("STEP5：稼働率計算 完了")
Exit Sub

ERR_HANDLER:
    Call ErrorRollback("STEP5：未知のエラー発生 → " & Err.Description)
End Sub

