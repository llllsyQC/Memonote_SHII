' === 数字抽出関数（基準値・現在庫から数値を抜き出す） ===
Function ExtractFirstNumber(ByVal txt As String) As Double
    Dim regex As Object
    Set regex = CreateObject("VBScript.RegExp")
    
    regex.Pattern = "\d+(\.\d+)?"  ' 数字（整数または小数）
    regex.Global = False
    
    If regex.test(txt) Then
        ExtractFirstNumber = CDbl(regex.Execute(txt)(0))
    Else
        ExtractFirstNumber = -1  ' 数字が見つからなければ-1（形式不明）
    End If
End Function

' === メイン処理：在庫数の変更時に補充要否を自動判定・色付け ===
Private Sub Worksheet_Change(ByVal Target As Range)
    Dim checkRow As Long
    Dim actualStock As Double
    Dim threshold As Double
    Dim stockRaw As String
    Dim thresholdRaw As String

    ' 対象：F4〜F100 の入力のみ
    If Not Intersect(Target, Range("F4:F100")) Is Nothing Then
        Application.EnableEvents = False

        For Each cell In Intersect(Target, Range("F4:F100"))
            checkRow = cell.Row

            ' 原文取得（単位付きのまま）
            stockRaw = Trim(Cells(checkRow, "F").Value)
            thresholdRaw = Trim(Cells(checkRow, "H").Value)

            ' 数字部分だけ抽出
            actualStock = ExtractFirstNumber(stockRaw)
            threshold = ExtractFirstNumber(thresholdRaw)

            ' 背景色初期化（A〜H列）
            Range("A" & checkRow & ":H" & checkRow).Interior.ColorIndex = xlNone

            ' 判定ロジック
            If stockRaw = "" Or thresholdRaw = "" Then
                Cells(checkRow, "G").Value = ""
            ElseIf actualStock < 0 Or threshold < 0 Then
                Cells(checkRow, "G").Value = "⚠形式不明"
            ElseIf actualStock = 0 Then
                Cells(checkRow, "G").Value = "補充要"
                Range("A" & checkRow & ":H" & checkRow).Interior.Color = RGB(255, 255, 153)
            ElseIf actualStock <= threshold Then
                Cells(checkRow, "G").Value = "補充要"
                Range("A" & checkRow & ":H" & checkRow).Interior.Color = RGB(255, 255, 153)
            Else
                Cells(checkRow, "G").Value = "OK"
            End If
        Next cell

        Application.EnableEvents = True
    End If
End Sub


消耗品チェックリスト運用変更のお知らせ（VBA対応版）

お疲れ様です。
この度、森田氏からのご指摘および運用上の課題を踏まえ、「消耗品チェックリスト」のフォーマットおよび運用方法を見直しました。以下に、変更の背景・目的・具体的な変更点・使用方法・注意事項についてご説明いたします。

⸻

変更の背景
	•	現行フォーマットでは、フォントが小さく視認性が悪い
	•	レイアウトが過密で、点検時に確認しづらい
	•	「出」「入」の記入が必要で、手計算が発生する
	•	G列（カウント基準）と補充判定が混在しており、誤解を招きやすい
	•	毎月1回の使用にもかかわらず、運用が煩雑すぎる
	•	点検者（OP）と発注判断者の役割が明確に分かれていない

⸻

変更の目的
	•	点検者が入力するのは「現在の在庫数」のみとし、それに基づき自動的に「補充要否」を判定できるようにすることで、人的ミスや手間を削減する
	•	G列は、点検前は「カウント基準」として使用し、点検後は「補充結果」として自動的に内容が更新される設計とする
	•	VBAを活用することで、視認性を高め、判断が即座にできるフォーマットにする
	•	あくまでも「今、在庫が基準値を下回っているか」の判定を目的とし、「出庫数」や「入庫数」の記録は行わない方針とする

⸻

変更内容
	•	点検欄（F列）に在庫数を入力すると、発注基準（H列）と自動的に比較され、G列に「補充要」または「OK」と表示される
	•	「補充要」と判定された行は、自動的にA〜H列全体が黄色で強調表示される
	•	G列は点検前は「カウント基準」として、点検後は「補充判定結果」として上書きされる
	•	入出庫や使用履歴の記録機能は一切廃止し、月次単位での運用に限定
	•	基準値や在庫数が「残量少（2連以下）」などの形式でも、数値を抽出して正しく判定できるよう正規表現処理を導入

⸻

使用方法
	•	テンプレートファイル（消耗品チェックリスト）を必ずコピーして使用してください
	•	ファイル名を「消耗品チェックリストYYYYMM（例：202506）」の形式で保存してください
	•	コピー後、原紙を印刷し、点検用紙として使用してください
	•	点検者（OP）は、現場で各項目の在庫数を確認し、F列に実数を記入してください
	•	記入と同時に、G列に自動的に「補充要」または「OK」と表示され、該当行が色付きになります
	•	点検完了後は、そのExcelファイルを改めて印刷し、発注判断資料として使用してください

⸻

注意事項
	•	元のテンプレートファイルは上書きしないでください。必ずコピーして使用してください
	•	ファイル形式は .xlsm（マクロ有効ブック） で保存してください
	•	VBAは「現在庫数 ＜ 発注基準」の場合に「補充要」と判定します（等しい場合はOK）
	•	基準欄や在庫数欄に数値が含まれていない場合、「⚠形式不明」と表示されます
	•	本フォーマットは、「今、在庫が足りているかどうか」の確認を目的としており、出庫数や入庫数の記録は行いません。使用量などを把握したい場合は、点検者が前月ファイルと比較して手動で確認してください
	•	G列は点検後に自動的に内容が上書きされるため、点検前に必要な基準情報を確認してから入力を行ってください
