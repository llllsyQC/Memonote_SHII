Private Sub Worksheet_Change(ByVal Target As Range)
    Dim checkRow As Long
    Dim actualStock As Double
    Dim threshold As Double
    Dim stockRaw As String
    Dim thresholdRaw As String

    ' F4:F100の変更を監視 memo: 点検欄の入力のみを対象とする
    If Not Intersect(Target, Range("F4:F100")) Is Nothing Then
        Application.EnableEvents = False

        For Each cell In Intersect(Target, Range("F4:F100"))
            checkRow = cell.Row

            stockRaw = Trim(Cells(checkRow, "F").Value)
            thresholdRaw = Trim(Cells(checkRow, "H").Value)

            actualStock = Val(stockRaw)
            threshold = Val(thresholdRaw)

            ' 行の色をリセット memo: まず全て初期化
            Range("A" & checkRow & ":H" & checkRow).Interior.ColorIndex = xlNone

            ' 空欄・形式不明チェック
            If stockRaw = "" Or thresholdRaw = "" Then
                Cells(checkRow, "G").Value = ""
            ElseIf Not stockRaw Like "*#*" Then
                Cells(checkRow, "G").Value = "⚠形式不明"
            ElseIf Not thresholdRaw Like "*#*" Then
                Cells(checkRow, "G").Value = "⚠形式不明"
            
            ' ⭐ 在庫ゼロ → 補充要
            ElseIf actualStock = 0 Then
                Cells(checkRow, "G").Value = "補充要"
                Range("A" & checkRow & ":H" & checkRow).Interior.Color = RGB(255, 255, 153)

            ' 基準未満 → 補充要
            ElseIf actualStock < threshold Then
                Cells(checkRow, "G").Value = "補充要"
                Range("A" & checkRow & ":H" & checkRow).Interior.Color = RGB(255, 255, 153)

            ' 基準以上 → OK（色なし）
            Else
                Cells(checkRow, "G").Value = "OK"
            End If
        Next cell

        Application.EnableEvents = True
    End If
End Sub